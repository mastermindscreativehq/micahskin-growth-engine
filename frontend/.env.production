# VITE_API_URL intentionally unset in production — API calls go to the same origin
# and are proxied to Railway by the /api rewrite in vercel.json. This makes the
# admin session cookie first-party so it persists on mobile browsers.
# Production pricing — must match backend PREMIUM_PRICE_NGN / BASIC_PRICE_NGN
VITE_BASIC_PRICE_NGN=50000
VITE_PREMIUM_PRICE_NGN=60000
